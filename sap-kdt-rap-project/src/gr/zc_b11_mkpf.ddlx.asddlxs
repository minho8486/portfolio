@Metadata.layer: #CUSTOMER
@UI: {
    headerInfo: {
        typeName: 'GR Info',
        typeNamePlural: 'Goods Receipt List',
        title: { value: 'Mblnr' },
        description: { value: 'Bktxt' }
    }
}

@UI.presentationVariant: [{
  sortOrder: [
    { by: 'Bldat', direction: #DESC },
    { by: 'Mblnr', direction: #ASC }
  ],
  visualizations: [{ type: #AS_LINEITEM }]
}]
annotate entity zc_b11_mkpf with
{
  @UI: {   selectionField: [{ element: 'Bldat', position : 10 }],
       lineItem: [ { position: 10, importance: #HIGH, label: 'Document Date' } ] }
  Bldat;

  @UI: { selectionField: [{ element: 'Mjahr', position : 20 }],
        lineItem: [ { position: 20, importance: #HIGH } ] }
  Mjahr;

  @UI: { selectionField: [{ element: 'Mblnr', position : 30 }],
        lineItem: [ { position: 30, importance: #HIGH }] }
  Mblnr;

  @UI: { selectionField: [{ element: 'Budat', position : 40 }],
        lineItem: [ { position: 40, importance: #HIGH } ] }
  Budat;

  @UI: { lineItem: [ { position: 50, importance: #HIGH } ] }
  Cpudt;



  @UI: { hidden: true }
  MblnrUuid;
  @UI: { hidden: true }
  CreatedBy;
  @UI: { hidden: true }
  CreatedAt;
  @UI: { hidden: true }
  ChangedBy;
  @UI: { hidden: true }
  ChangedAt;
  @UI: { hidden: true }
  LocChangedAt;

}