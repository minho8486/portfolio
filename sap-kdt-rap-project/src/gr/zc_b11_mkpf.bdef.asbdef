projection;
strict ( 2 );
use draft;
use side effects;

define behavior for zc_b11_mkpf alias GRHeader
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _GRItem { create; with draft; }
}

define behavior for zc_b11_mseg alias GRItem
{
  use update;
  use delete;

  use association _GRHeader { with draft; }
}