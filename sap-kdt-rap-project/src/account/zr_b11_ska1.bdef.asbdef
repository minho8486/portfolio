managed implementation in class zbp_r_b11_ska1 unique;
strict ( 2 );

define behavior for zr_b11_ska1 alias Account
persistent table ztb11ska1
lock master
authorization master ( instance )
etag master ChangedAt
{
  create;
  update;
  delete (features : instance);
  association _AccountText { create; }

  side effects
  {
    action SetRemoved affects field Xloev, permissions ( action SetRemoved );
  }

  field ( numbering : managed, readonly ) SakUuid;
  field ( readonly : update ) Saknr;
  field ( mandatory : create ) Saknr, Glact;
  field ( features : instance ) Xloev;

  action ( features : instance ) SetRemoved;

  validation CheckSaknr on save { create; field Saknr; }
  validation CheckAccountType on save { create; field Glact; }

  mapping for ztb11ska1 corresponding
    {
      SakUuid   = sak_uuid;
      CreatedBy = created_by;
      CreatedAt = created_at;
      ChangedBy = changed_by;
      ChangedAt = changed_at;
    }
}

define behavior for zi_b11_ska1text alias AccountText
persistent table ztb11ska1_t
lock dependent by _Account
authorization dependent by _Account
//etag master <field_name>
{
  update;
  delete;

  field ( readonly ) SakUuid;
  field ( readonly : update ) Spras;
  field ( mandatory : create ) Spras;

  validation CheckText on save { create; update; }

  association _Account;

  mapping for ztb11ska1_t corresponding
    {
      SakUuid   = sak_uuid;
    }
}