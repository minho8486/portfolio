managed implementation in class zbp_r_b11_eina unique;
strict ( 2 );
with draft;

define behavior for zr_b11_eina alias PIRHeader
persistent table ztb11eina
draft table ztb11eina_d
lock master
total etag ChangedAt
authorization master ( instance )
etag master LocChangedAt
{
  create;
  update;
  delete ( features : instance );
  association _PIRItem { create; with draft; }

  side effects
  {
    action SetBlocked affects field Loekz, permissions ( action SetBlocked );
    field Matnr affects field MaterialUuid;
    field Lifnr affects field VendorUuid;
  }

  field ( numbering : managed, readonly ) InfUuid;
  field ( readonly ) Infnr, Name1, Maktx;
  field ( features : instance ) loekz, Matnr, Lifnr;

  action ( features : instance ) SetBlocked;

  validation CheckMatnr on save { create; update; field MaterialUuid; }
  validation CheckLifnr on save { create; update; field VendorUuid; }
  validation CheckSemanticKeys on save { create; field Matnr, Lifnr; }

  determination SetInfnf on save { create; }
  determination SetMeins on save { create; }
  determination ClearUuid on save { create; field Matnr, Lifnr; }

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    determination ClearUuid;

    validation CheckMatnr;
    validation CheckLifnr;
    validation CheckSemanticKeys;
  }

  mapping for ztb11eina corresponding
    {
      InfUuid      = inf_uuid;
      MaterialUuid = material_uuid;
      InfoText     = info_text;
      VendorUuid   = vendor_uuid;
      CreatedBy    = created_by;
      CreatedAt    = created_at;
      ChangedBy    = changed_by;
      ChangedAt    = changed_at;
      LocChangedAt = loc_changed_at;
    }
}

define behavior for zi_b11_eine alias PIRItem
persistent table ztb11eine
draft table ztb11eine_d
lock dependent by _PIRHeader
authorization dependent by _PIRHeader
//etag master ChangedAt
{
  update;
  delete ( features : instance );
  association _PIRHeader { with draft; }

  field ( readonly ) InfUuid, PlantName;
  field ( readonly : update ) Werks;
  field ( mandatory : create ) Werks;
  field ( features : instance ) Waers, Meins, Loekz;

  action ( features : instance ) SetBlocked;

  validation CheckPlant on save { create; update; field Werks; }
  validation CheckPrdat on save { create; update; field Prdat; }
  validation CheckNetpr on save { create; update; field Netpr; }
  validation CheckBstma on save { create; update; field Bstma; }
  validation CheckMinbm on save { create; update; field Minbm; }
  validation CheckAplfz on save { create; update; field Aplfz; }

  determination SetPlantName on modify { create; field Werks; }
  determination SetPrdat on modify { create; }
  determination SetWaers on modify { create; }
  determination SetMeins on modify { create; }
  determination SetNetpr on save { create; }

  mapping for ztb11eine corresponding
    {
      InfUuid   = inf_uuid;
      CreatedBy = created_by;
      CreatedAt = created_at;
      ChangedBy = changed_by;
      ChangedAt = changed_at;
    }
}