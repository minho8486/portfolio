@Metadata.layer: #CUSTOMER
@UI: { 
    headerInfo: { 
        typeName: 'Purchase Info',
        typeNamePlural: 'Purchase Info List',
        title: { value: 'Infnr' },
        description: { value: 'Lifnr' }
    },
    presentationVariant: [{
        sortOrder: [
            { by: 'Lifnr', direction: #ASC },
            { by: 'Matnr', direction: #ASC }
        ],
        visualizations: [
            { type: #AS_LINEITEM }
        ]
    }]
}
annotate entity zc_b11_eina with
{
  @UI: { lineItem: [ { position: 10, importance: #HIGH},
                     { type: #FOR_ACTION, dataAction: 'SetBlocked', label: 'Blocked' } ] }
  Lifnr;
  @UI: { lineItem: [ { position: 20, importance: #HIGH} ] }
  Matnr;
  @UI: { lineItem: [ { position: 30, importance: #HIGH} ] }
  Infnr;
  @UI.hidden: true
  InfUuid;
  @UI.hidden: true
  CreatedBy;
  @UI.hidden: true
  CreatedAt;
  @UI.hidden: true
  ChangedBy;
  @UI.hidden: true
  ChangedAt;
  @UI.hidden: true
  LocChangedAt;

}