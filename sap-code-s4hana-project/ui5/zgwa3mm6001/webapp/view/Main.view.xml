<mvc:View
    controllerName="zpa3.zgwa3mm6001.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <f:DynamicPage
        id="page"
        headerExpanded="true"
        toggleHeaderOnTitleClick="false"
        class="sapUiResponsiveContentPadding">

        <f:title>
            <f:DynamicPageTitle>

                <f:heading>
                    <Title text="[A3] 재고 집계 조회" level="H2"/>
                </f:heading>

                <f:expandedContent>
                    <Label text="자재번호, 플랜트, 제조일자를 기준으로 재고를 조회합니다."/>
                </f:expandedContent>

                <f:actions>
                    <Button
                        text="검색"
                        icon="sap-icon://search"
                        type="Emphasized"
                        press=".onSearch"/>

                    <Button
                        text="초기화"
                        icon="sap-icon://reset"
                        press=".onReset"/>
                </f:actions>

            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <core:Fragment
                    fragmentName="zpa3.zgwa3mm6001.view.Cond"
                    type="XML"/>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>

            <VBox width="100%" class="sapUiSmallMarginTop">

                <Panel
                    headerText="조회 결과"
                    expandable="false"
                    width="100%"
                    class="sapUiNoContentPadding">

                    <Table
                        id="tabIdList"
                        items="{
                            path: '/esMaterialSet',
                            suspended: true
                        }"
                        growing="true"
                        growingThreshold="20"
                        growingScrollToLoad="true"
                        sticky="ColumnHeaders,HeaderToolbar"
                        alternateRowColors="true"
                        fixedLayout="false"
                        inset="false"
                        width="100%">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="재고 집계 목록" level="H3"/>
                                <ToolbarSpacer/>

                                <Button
                                    icon="sap-icon://refresh"
                                    text="새로고침"
                                    type="Transparent"
                                    press=".onSearch"/>
                            </OverflowToolbar>
                        </headerToolbar>

                        <columns>
                            <Column minScreenWidth="Tablet" demandPopin="true">
                                <Text text="자재번호"/>
                            </Column>

                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="플랜트"/>
                            </Column>

                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="플랜트명"/>
                            </Column>

                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="배치번호"/>
                            </Column>

                            <Column minScreenWidth="Desktop" demandPopin="true">
                                <Text text="제조일자"/>
                            </Column>

                            <Column hAlign="End">
                                <Text text="재고수량"/>
                            </Column>

                            <Column hAlign="End">
                                <Text text="폐기수량"/>
                            </Column>

                            <Column>
                                <Text text="단위"/>
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem
                                type="Navigation"
                                press=".onPressMaterial"
                                vAlign="Middle">

                                <cells>
                                    <ObjectIdentifier
                                        title="{Matid}"
                                        text="{Mtext}"/>

                                    <Text text="{Plaid}"/>

                                    <Text text="{Pname}"/>

                                    <Text text="{Batid}"/>

                                    <Text
                                        text="{
                                            path: 'Hsdat',
                                            type: 'sap.ui.model.type.Date',
                                            formatOptions: {
                                                pattern: 'yyyy-MM-dd'
                                            }
                                        }"/>

                                    <ObjectNumber
                                        number="{Labst}"
                                        unit="{Meins}"
                                        emphasized="true"/>

                                    <ObjectNumber
                                        number="{Scrap}"
                                        unit="{Meins}"
                                        state="Warning"/>

                                    <ObjectStatus
                                        text="{Meins}"
                                        state="Information"/>
                                </cells>

                            </ColumnListItem>
                        </items>

                    </Table>

                </Panel>

            </VBox>

        </f:content>

    </f:DynamicPage>
</mvc:View>