MODULE status_0100 OUTPUT.
  SET PF-STATUS 'S100'.
  SET TITLEBAR 'T100'.
ENDMODULE.


*&---------------------------------------------------------------------*
*& Module SET_ALV_0100 OUTPUT
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*


MODULE set_alv_0100 OUTPUT.
  PERFORM create_container USING go_con go_alv 'CON_MAIN'.

  PERFORM set_layout_0100 CHANGING gs_layo.
  PERFORM set_fcat_0100 TABLES gt_fcat.

  PERFORM display_alv TABLES gt_fcat
                      USING 'ZSA3MM6008' go_alv gt_list gs_layo.
ENDMODULE.


